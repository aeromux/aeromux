<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Aeromux.Core\Aeromux.Core.csproj" />
    <PackageReference Include="RtlSdrManager" Version="0.7.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <!-- Explicit override: Microsoft.Data.Sqlite 10.0.9 pulls SQLitePCLRaw 2.1.11, which is
         flagged by GHSA-2m69-gcr7-jv3q (bundled SQLite). The fix is only in the 3.0.x line.
         Remove this pin once Microsoft.Data.Sqlite depends on SQLitePCLRaw 3.x directly. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
