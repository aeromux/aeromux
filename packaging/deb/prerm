#!/bin/bash
set -e

case "$1" in
    remove)
        # Stop service if active
        if systemctl is-active --quiet aeromux; then
            systemctl stop aeromux
        fi

        # Disable service if enabled
        if systemctl is-enabled --quiet aeromux; then
            systemctl disable aeromux
        fi
        ;;
    upgrade)
        # Leave the service running and enabled. dpkg renames the new binary
        # into place, so the running process is unaffected, and postinst
        # restarts it on the new version. Disabling here would leave the
        # service off after every upgrade or reinstall.
        ;;
esac

exit 0
